PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_student_portal_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# Database Configuration
# Set DB_TYPE to 'postgres' to use PostgreSQL, or 'sqlite' for zero-config local relational DB
DB_TYPE=sqlite
# For PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studentp_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=studentp_db

# SQLite database file path (used if DB_TYPE=sqlite or fallback)
SQLITE_DB_PATH=./data/studentp.db
